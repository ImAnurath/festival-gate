generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Status {
  PENDING
  APPROVED
  REJECTED
  PAID
}

model Application {
  id                String   @id @default(cuid())
  createdAt         DateTime @default(now())
  name              String
  email             String
  phone             String?
  socialTags        String
  ticketQuantity    Int
  guestNames        String   // JSON-encoded string[] (kept as text for simplicity)
  guestSocials      String   @default("[]") // JSON-encoded string[] of guest Instagram handles, parallel to guestNames
  childCount        Int      @default(0)     // children under 12 (free, not counted as tickets)
  status            Status   @default(PENDING)
  payToken          String?  @unique
  payTokenExpiresAt DateTime?
  amount            Int?
  paymentRef        String?
  paidAt            DateTime?
  reviewNote        String?
  ticketsAccessToken String?  @unique
  tickets           Ticket[]
}

model AdminUser {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String
}

enum TicketStatus {
  VALID
  USED
}

// One row per attendee (buyer + each named guest). Created when an application
// is paid. `verifyToken` is the opaque QR payload; `code` is a short, human
// code for door staff. `status`/`checkedInAt` are set at check-in (later SP).
model Ticket {
  id            String       @id @default(cuid())
  applicationId String
  application   Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  holderName    String
  isBuyer       Boolean      @default(false)
  code          String       @unique
  verifyToken   String       @unique
  status        TicketStatus @default(VALID)
  checkedInAt   DateTime?
  createdAt     DateTime     @default(now())

  @@index([applicationId])
}

// One row per failed admin-login attempt, used to rate-limit brute force.
// `key` is the client identifier (e.g. "login:<ip>"). Rows older than the
// rate-limit window are pruned opportunistically on each failure.
model LoginAttempt {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}
