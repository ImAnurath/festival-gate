# Postgres connection string. Local example below; in production (Vercel)
# use the hosted Postgres URL (Neon / Vercel Postgres / Supabase).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/festival_gate?schema=public"
SESSION_PASSWORD="change-me-to-a-32+char-random-string"
EVENT_NAME="KİNDZİ FEST"
TICKET_PRICE="3000"
MAX_TICKETS_PER_BUYER="3"
PAY_TOKEN_TTL_HOURS="72"
PAYMENT_PROVIDER="stub"
# Master switch for the online card-payment ("Şimdi öde") option. While "false"
# the pay page offers only Havale / EFT. Flip to "true" once iyzico is live.
# (The iyzico logos and the public payment demo stay visible regardless.)
ONLINE_PAYMENT_ENABLED="false"
NOTIFIER="console"
RESEND_API_KEY=""
MAIL_FROM="Festival <tickets@example.com>"
# Gmail SMTP. Uses a 16-char App Password, NOT your normal password: enable
# 2-Step Verification on the account, then Google Account -> Security -> App
# passwords. MAIL_FROM must use this same Gmail address.
# Two uses:
#   1. NOTIFIER=gmail makes Gmail the only sender.
#   2. NOTIFIER=resend AND both vars below set auto-enables a Gmail fallback:
#      if a Resend send fails for any reason (free-tier quota exhausted, rate
#      limit, or other error), the same email is retried through Gmail. Leave
#      these blank to disable the fallback.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
# WhatsApp delivery for the approval pay link. "console" just logs (default).
# "meta" = Meta WhatsApp Cloud API direct (cheaper, no BSP). "twilio" = via Twilio.
WHATSAPP_PROVIDER="console"
# Meta Cloud API (WHATSAPP_PROVIDER=meta)
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PAYLINK_TEMPLATE=""
WHATSAPP_PAYLINK_TEMPLATE_LANG="tr"
# Tickets retrieval-link template (sent after payment). Optional: if unset, the
# email still delivers the PDF; sendTicketsLink throws (best-effort) until set.
WHATSAPP_TICKETS_TEMPLATE=""
WHATSAPP_TICKETS_TEMPLATE_LANG="tr"
# Twilio (WHATSAPP_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM=""
TWILIO_PAYLINK_CONTENT_SID=""
# Twilio tickets retrieval-link content template (optional, like the Meta one above)
TWILIO_TICKETS_CONTENT_SID=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"
EVENT_END="2026-09-01T21:00:00.000Z"
# Havale / EFT manual bank transfer. Shown to buyers who choose "Havale / EFT
# ile öde" on the pay page. All three are REQUIRED (the app will not boot
# without them). Set the real values in the Vercel project env before deploy.
HAVALE_IBAN="TR000000000000000000000000"
HAVALE_ACCOUNT_NAME="Hesap Sahibinin Adı"
HAVALE_BANK_NAME="Banka Adı"
